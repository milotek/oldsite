# Public URL of the deployed site and the subpath it lives under.
SITE_URL=https://milotek.dev
SITE_BASE=/

# Last.fm now-playing card. Leave blank to fall back to a plain Spotify link.
PUBLIC_LASTFM_USER=
PUBLIC_LASTFM_API_KEY=

# Set to 1 to include vault posts that have no `published` date.
PUBLISH_DRAFTS=
