{
  "name": "milotek-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "vault": "tsx scripts/build-vault.ts",
    "dev": "npm run vault && vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build": "npm run vault && npm run build:client && npm run build:server && tsx scripts/prerender.ts",
    "preview": "vite preview --outDir dist/client"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "feed": "^6.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "rehype-callouts": "^2.2.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2"
  }
}
