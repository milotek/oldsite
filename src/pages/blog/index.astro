---
import { getPosts } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import Win from '../../components/Win.astro';
import { url } from '../../lib/url';
import { isoDate } from '../../lib/time';

const posts = await getPosts();
---

<Base title="blog" description="Writing by Milo Tekchandani. Keyboards, VR headsets, Lua, whatever else.">
  <Win title="~/blog" meta={posts.length ? `${posts.length} post${posts.length === 1 ? '' : 's'}` : undefined} focus>
    <p class="lead">
      Opinions, mostly about hardware and software that annoyed me. There is an <a href={url('rss.xml')}>RSS feed</a>.
    </p>
    {
      posts.length ? (
        <ul class="posts">
          {posts.map((p) => (
            <li class="card">
              <time class="mono muted" datetime={isoDate(p.data.published)}>
                {isoDate(p.data.published)}
              </time>
              <div>
                <a class="title" href={url(`blog/${p.id}/`)}>
                  {p.data.title}
                </a>
                {p.data.draft && <span class="pill" data-status="in-progress">draft</span>}
                {p.data.summary && <p class="muted">{p.data.summary}</p>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Nothing published yet. The drafts folder is doing fine though.</p>
      )
    }
  </Win>
</Base>

<style>
  .lead {
    color: var(--subtext1);
    margin: 0 0 1.5rem;
  }
  .posts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .posts li {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .title:hover {
    text-decoration: underline;
  }
  .pill {
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  @media (max-width: 30rem) {
    .posts li {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
