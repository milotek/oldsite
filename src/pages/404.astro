---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import { url } from '../lib/url';
---

<Base title="404" description="Not here.">
  <Win title="~/404" meta="no such file or directory" focus>
    <div class="wrap">
      <img
        src={url('under_construction.gif')}
        alt="A shitty drawn image of a "
        width="480"
        height="360"
      />
      <h1>404</h1>
      <p class="muted">There is nothing at this address.</p>
      <p><a href={url('')}>Back home</a></p>
    </div>
  </Win>
</Base>

<style>
  .wrap {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .wrap img {
    border-radius: var(--radius-sm);
    max-width: 24rem;
  }
</style>
